@model DACS_Nhom3.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thông tin cá nhân";
    var avatar = string.IsNullOrWhiteSpace(Model.CurrentAvatar) ? "/images/default-avatar.png" : Model.CurrentAvatar;
}

<style>
    body {
        background: #f4f7fb !important;
    }

    .profile-page-v2 {
        min-height: calc(100vh - 70px);
        padding: 42px 16px 70px;
        background: radial-gradient(circle at 10% 10%, rgba(255, 111, 97, .14), transparent 28%), radial-gradient(circle at 90% 12%, rgba(99, 102, 241, .14), transparent 30%), linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    }

    .profile-wrapper-v2 {
        max-width: 1120px;
        margin: 0 auto;
    }

    .profile-card-v2 {
        overflow: hidden;
        border-radius: 28px;
        background: #fff;
        border: 1px solid rgba(226, 232, 240, .95);
        box-shadow: 0 24px 70px rgba(15, 23, 42, .12);
    }

    .profile-header-v2 {
        position: relative;
        min-height: 245px;
        padding: 34px;
        display: flex;
        align-items: flex-end;
        gap: 24px;
        color: #fff;
        background: linear-gradient(90deg, rgba(15, 23, 42, .92), rgba(49, 46, 129, .75), rgba(249, 115, 22, .45)), url('@avatar') center 38% / cover no-repeat;
    }

        .profile-header-v2::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(15, 23, 42, .1), rgba(15, 23, 42, .72));
            pointer-events: none;
        }

    .profile-avatar-box-v2,
    .profile-title-v2 {
        position: relative;
        z-index: 1;
    }

    .profile-avatar-box-v2 {
        width: 142px;
        height: 142px;
        flex: 0 0 142px;
        border-radius: 30px;
        padding: 5px;
        background: rgba(255, 255, 255, .9);
        box-shadow: 0 18px 45px rgba(0, 0, 0, .3);
    }

        .profile-avatar-box-v2 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 25px;
            display: block;
        }

    .profile-title-v2 .badge-soft-v2 {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        padding: 8px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        backdrop-filter: blur(10px);
        font-weight: 700;
        font-size: 13px;
    }

    .profile-title-v2 h1 {
        margin: 0 0 8px;
        font-size: clamp(28px, 4vw, 46px);
        line-height: 1.05;
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .profile-title-v2 p {
        max-width: 650px;
        margin: 0;
        color: rgba(255,255,255,.86);
        font-size: 15px;
    }

    .profile-body-v2 {
        padding: 28px;
    }

    .profile-alert-v2 {
        margin-bottom: 20px;
        padding: 14px 16px;
        border-radius: 16px;
        color: #166534;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
        font-weight: 600;
    }

    .profile-grid-v2 {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(320px, .85fr);
        gap: 22px;
    }

    .profile-section-v2 {
        padding: 24px;
        border-radius: 24px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        box-shadow: 0 12px 34px rgba(15, 23, 42, .06);
    }

    .section-title-v2 {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 22px;
    }

    .section-icon-v2 {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 15px;
        color: #fff;
        background: linear-gradient(135deg, #fb7185, #f97316);
        box-shadow: 0 12px 24px rgba(249, 115, 22, .25);
    }

    .section-title-v2 h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
        color: #0f172a;
    }

    .section-title-v2 p {
        margin: 2px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .form-grid-v2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .field-full-v2 {
        grid-column: 1 / -1;
    }

    .profile-page-v2 label {
        margin-bottom: 7px;
        color: #334155;
        font-weight: 800;
        font-size: 13px;
    }

    .profile-page-v2 .form-control,
    .profile-page-v2 .form-select {
        min-height: 46px;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        background-color: #f8fafc;
        color: #0f172a;
        font-size: 14px;
        box-shadow: none !important;
    }

        .profile-page-v2 .form-control:focus,
        .profile-page-v2 .form-select:focus {
            border-color: #f97316;
            background: #fff;
            box-shadow: 0 0 0 .22rem rgba(249, 115, 22, .13) !important;
        }

    .profile-hint-v2 {
        display: block;
        margin-top: 7px;
        color: #64748b;
        font-size: 12px;
    }

    .profile-note-v2 {
        margin-bottom: 15px;
        padding: 13px 15px;
        border-radius: 16px;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        font-size: 13px;
        line-height: 1.5;
    }

    .password-stack-v2 {
        display: grid;
        gap: 15px;
    }

    .profile-actions-v2 {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid #e5e7eb;
    }

        .profile-actions-v2 .btn {
            min-height: 46px;
            padding: 10px 18px;
            border-radius: 14px;
            font-weight: 800;
        }

    .btn-back-v2 {
        color: #334155 !important;
        background: #f8fafc !important;
        border: 1px solid #e2e8f0 !important;
    }

    .btn-save-v2 {
        color: #fff !important;
        border: 0 !important;
        background: linear-gradient(135deg, #f97316, #ef4444) !important;
        box-shadow: 0 14px 30px rgba(249, 115, 22, .28);
    }

        .btn-save-v2:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 36px rgba(249, 115, 22, .36);
        }

    .text-danger {
        font-size: 12px;
        font-weight: 600;
    }

    @@media (max-width: 992px) {
        .profile-grid-v2 {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .profile-page-v2 {
            padding: 22px 10px 46px;
        }

        .profile-header-v2 {
            min-height: auto;
            padding: 26px;
            align-items: flex-start;
            flex-direction: column;
        }

        .profile-avatar-box-v2 {
            width: 118px;
            height: 118px;
            flex-basis: 118px;
        }

        .profile-body-v2 {
            padding: 18px;
        }

        .profile-section-v2 {
            padding: 18px;
        }

        .form-grid-v2 {
            grid-template-columns: 1fr;
        }

        .profile-actions-v2 {
            flex-direction: column-reverse;
        }

            .profile-actions-v2 .btn {
                width: 100%;
            }
    }
</style>

<section class="profile-page-v2">
    <div class="profile-wrapper-v2">
        <div class="profile-card-v2">
            <div class="profile-header-v2">
                <div class="profile-avatar-box-v2">
                    <img src="@avatar" alt="Avatar" onerror="this.src='/images/default-avatar.png'" />
                </div>

                <div class="profile-title-v2">
                    <span class="badge-soft-v2"><i class="fas fa-user-cog"></i> Tài khoản của tôi</span>
                    <h1>Chỉnh sửa thông tin cá nhân</h1>
                    <p>Cập nhật hồ sơ, ảnh đại diện, địa chỉ, tuổi, giới tính và đổi mật khẩu trong một trang gọn gàng hơn.</p>
                </div>
            </div>

            <div class="profile-body-v2">
                @if (TempData["Success"] != null)
                {
                    <div class="profile-alert-v2">
                        <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
                    </div>
                }

                <form asp-action="Profile" asp-controller="Account" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="profile-grid-v2">
                        <div class="profile-section-v2">
                            <div class="section-title-v2">
                                <div class="section-icon-v2"><i class="fas fa-id-card"></i></div>
                                <div>
                                    <h2>Thông tin cơ bản</h2>
                                    <p>Những thông tin hiển thị trong tài khoản.</p>
                                </div>
                            </div>

                            <div class="form-grid-v2">
                                <div>
                                    <label asp-for="FullName"></label>
                                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ tên" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>

                                <div>
                                    <label asp-for="PhoneNumber"></label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div>
                                    <label asp-for="Age"></label>
                                    <input asp-for="Age" type="number" min="1" max="120" class="form-control" placeholder="Ví dụ: 20" />
                                    <span asp-validation-for="Age" class="text-danger"></span>
                                </div>

                                <div>
                                    <label asp-for="Gender"></label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="">-- Chọn giới tính --</option>
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>

                                <div class="field-full-v2">
                                    <label asp-for="Address"></label>
                                    <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ" />
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>

                                <div class="field-full-v2">
                                    <label asp-for="AvatarFile"></label>
                                    <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
                                    <small class="profile-hint-v2">Chỉ nhận JPG, PNG, GIF, WEBP. Tối đa 2MB.</small>
                                    <span asp-validation-for="AvatarFile" class="text-danger d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="profile-section-v2">
                            <div class="section-title-v2">
                                <div class="section-icon-v2"><i class="fas fa-shield-alt"></i></div>
                                <div>
                                    <h2>Đổi mật khẩu</h2>
                                    <p>Bỏ trống nếu bạn chưa muốn đổi.</p>
                                </div>
                            </div>

                            <div class="password-stack-v2">
                                @if (Model.HasPassword)
                                {
                                    <div>
                                        <label asp-for="CurrentPassword"></label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                    </div>
                                }
                                else
                                {
                                    <div class="profile-note-v2">
                                        Tài khoản Google chưa có mật khẩu riêng. Nhập mật khẩu mới để có thể đăng nhập bằng email/mật khẩu.
                                    </div>
                                }

                                <div>
                                    <label asp-for="NewPassword"></label>
                                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>

                                <div>
                                    <label asp-for="ConfirmNewPassword"></label>
                                    <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="profile-actions-v2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-back-v2">
                            <i class="fas fa-arrow-left me-1"></i> Về trang chủ
                        </a>
                        <button type="submit" class="btn btn-save-v2">
                            <i class="fas fa-save me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
