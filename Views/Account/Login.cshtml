@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS_Nhóm3</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2D3E50;
            --secondary: #E67E22;
            --dark: #1a1a2e;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .login-container {
            max-width: 450px;
            margin: 0 auto;
            padding: 2rem;
        }

        .login-card {
            background: white;
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            animation: fadeInUp 0.6s ease;
        }



        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }


        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

            .login-header h1 {
                font-family: 'Playfair Display', serif;
                font-size: 2rem;
                font-weight: 700;
                background: linear-gradient(135deg, var(--primary), var(--secondary));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 0.5rem;
            }

            .login-header p {
                color: #7f8c8d;
                font-size: 0.9rem;
            }

        .form-group {
            margin-bottom: 1.5rem;
        }

            .form-group label {
                font-weight: 500;
                color: var(--primary);
                margin-bottom: 0.5rem;
                display: block;
            }

        .input-group-text {
            background: transparent;
            border-right: none;
            color: var(--secondary);
        }

        .form-control {
            border-left: none;
            padding: 0.75rem;
            font-size: 1rem;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: var(--secondary);
            }

        .btn-login {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            padding: 0.85rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            color: white;
            width: 100%;
            transition: all 0.3s;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(230,126,34,0.4);
            }


        .external-divider {
            display: flex;
            align-items: center;
            gap: .75rem;
            color: #94a3b8;
            font-size: .85rem;
            margin: 1.25rem 0;
        }

            .external-divider::before,
            .external-divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #e5e7eb;
            }

        .btn-google {
            width: 100%;
            border: 1px solid #e5e7eb;
            background: #fff;
            color: #374151;
            border-radius: 50px;
            padding: .85rem;
            font-weight: 700;
            transition: all .25s;
        }

            .btn-google:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0,0,0,.08);
                border-color: #d1d5db;
            }

        .register-link {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #ecf0f1;
        }

            .register-link a {
                color: var(--secondary);
                text-decoration: none;
                font-weight: 600;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        .alert {
            border-radius: 15px;
            margin-bottom: 1.5rem;
        }

        .back-home {
            text-align: center;
            margin-top: 1rem;
        }

            .back-home a {
                color: white;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .back-home a:hover {
                    text-decoration: underline;
                }

        .input-group {
            flex-wrap: nowrap;
        }

            .input-group .form-control {
                min-width: 0;
            }



        {
            padding: 1rem;
        }

        .login-card {
            padding: 1.5rem;
            border-radius: 22px;
        }

        }</style>
</head>
<body>
    <div class="container">
        <div class="login-container">
            <div class="login-card">
                <div class="login-header">
                    <h1><i class="fas fa-book-open me-2"></i>DACS_Nhóm3</h1>
                    <p>Đăng nhập để tiếp tục đọc truyện</p>
                </div>

                @if (ViewBag.DisabledMessage != null)
                {
                    <div class="alert alert-danger">
                        <p class="mb-0">@ViewBag.DisabledMessage</p>
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        <p class="mb-0">@TempData["Success"]</p>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <p class="mb-0">@TempData["Error"]</p>
                    </div>
                }

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="form-group">
                        <label for="Email">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="Email" name="Email" required placeholder="example@email.com" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Password">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="Password" name="Password" required placeholder="••••••••" />
                        </div>
                    </div>

                    <div class="form-group d-flex justify-content-between align-items-center">
                        <div class="form-check mb-0">
                            <input type="checkbox" class="form-check-input" id="RememberMe" name="RememberMe" value="true" />
                            <label class="form-check-label" for="RememberMe">Ghi nhớ đăng nhập</label>
                        </div>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none" style="color: var(--secondary); font-weight: 600;">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                    </button>
                </form>



                <div class="external-divider">hoặc</div>

                <form asp-controller="Account" asp-action="ExternalLogin" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <button type="submit" class="btn-google">
                        <i class="fab fa-google me-2"></i>Đăng nhập bằng Google
                    </button>
                </form>

                <div class="register-link">
                    <p>Chưa có tài khoản? <a asp-controller="Account" asp-action="Register">Đăng ký ngay</a></p>
                </div>
            </div>

            <div class="back-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>