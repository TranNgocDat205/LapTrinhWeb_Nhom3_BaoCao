@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DACS_Nhóm3</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #2D3E50;
            --secondary: #E67E22;
            --dark: #1a1a2e;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding: 2rem 0;
        }

        .register-container {
            max-width: 500px;
            margin: 0 auto;
            padding: 2rem;
        }

        .register-card {
            background: white;
            border-radius: 30px;
            padding: 2.5rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            animation: fadeInUp 0.6s ease;
        }

       
        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .register-header {
            text-align: center;
            margin-bottom: 2rem;
        }

            .register-header h1 {
                font-family: 'Playfair Display', serif;
                font-size: 2rem;
                font-weight: 700;
                background: linear-gradient(135deg, var(--primary), var(--secondary));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                margin-bottom: 0.5rem;
            }

            .register-header p {
                color: #7f8c8d;
                font-size: 0.9rem;
            }

        .form-group {
            margin-bottom: 1.5rem;
        }

            .form-group label {
                font-weight: 500;
                color: var(--primary);
                margin-bottom: 0.5rem;
                display: block;
            }

        .input-group-text {
            background: transparent;
            border-right: none;
            color: var(--secondary);
        }

        .form-control {
            border-left: none;
            padding: 0.75rem;
            font-size: 1rem;
        }

            .form-control:focus {
                box-shadow: none;
                border-color: var(--secondary);
            }

        .btn-register {
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            padding: 0.85rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            color: white;
            width: 100%;
            transition: all 0.3s;
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(230,126,34,0.4);
            }

        .login-link {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #ecf0f1;
        }

            .login-link a {
                color: var(--secondary);
                text-decoration: none;
                font-weight: 600;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .alert {
            border-radius: 15px;
            margin-bottom: 1.5rem;
        }

        .password-requirements {
            font-size: 0.75rem;
            color: #7f8c8d;
            margin-top: 0.25rem;
        }

        .back-home {
            text-align: center;
            margin-top: 1rem;
        }

            .back-home a {
                color: white;
                text-decoration: none;
                font-size: 0.9rem;
            }

                .back-home a:hover {
                    text-decoration: underline;
                }

        .input-group {
            flex-wrap: nowrap;
        }

            .input-group .form-control {
                min-width: 0;
            }

       

        {
            padding: 1rem;
        }

        .register-card {
            padding: 1.5rem;
            border-radius: 22px;
        }

        }
    </style>
</head>
<body>
    <div class="container">
        <div class="register-container">
            <div class="register-card">
                <div class="register-header">
                    <h1><i class="fas fa-user-plus me-2"></i>Đăng ký</h1>
                    <p>Tạo tài khoản để trải nghiệm tốt hơn</p>
                </div>

                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="form-group">
                        <label for="FullName">Họ tên</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                            <input type="text" class="form-control" id="FullName" name="FullName" required placeholder="Nguyễn Văn A" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Email">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            <input type="email" class="form-control" id="Email" name="Email" required placeholder="example@email.com" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Password">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="Password" name="Password" required placeholder="••••••••" />
                        </div>
                        <div class="password-requirements">
                            <i class="fas fa-info-circle"></i> Mật khẩu phải có ít nhất 6 ký tự, bao gồm chữ hoa, chữ thường và số
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="ConfirmPassword">Xác nhận mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" required placeholder="••••••••" />
                        </div>
                    </div>

                    <button type="submit" class="btn-register">
                        <i class="fas fa-user-plus me-2"></i>Đăng ký
                    </button>
                </form>

                <div class="login-link">
                    <p>Đã có tài khoản? <a asp-controller="Account" asp-action="Login">Đăng nhập ngay</a></p>
                </div>
            </div>

            <div class="back-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-arrow-left me-1"></i> Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>