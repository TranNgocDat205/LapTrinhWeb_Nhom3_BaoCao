@model IEnumerable<DACS_Nhom3.Models.Genre>
@{
    ViewData["Title"] = "Thể loại yêu thích";
}

<div class="container py-5 favorite-genres-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title fw-bold mb-1">
                <i class="fas fa-star text-warning me-2"></i>Thể loại yêu thích
            </h1>
            <p class="text-muted mb-0">Các thể loại bạn quan tâm sẽ xuất hiện ở đây.</p>
        </div>

        <a asp-controller="Genre" asp-action="Index" class="btn btn-warning rounded-pill px-4">
            <i class="fas fa-tags me-1"></i>Khám phá thể loại
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var genre in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="favorite-genre-card card border-0 shadow rounded-4 h-100 text-center p-4">
                        <a asp-controller="Story" asp-action="Index" asp-route-genreId="@genre.Id" class="text-decoration-none">
                            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white"
                                 style="width:86px;height:86px;background:@(genre.Color ?? "#E67E22");font-size:2rem;">
                                <i class="@(string.IsNullOrWhiteSpace(genre.Icon) ? "fas fa-book" : genre.Icon)"></i>
                            </div>

                            <h4 class="fw-bold text-dark">@genre.Name</h4>
                        </a>

                        <p class="text-muted small flex-grow-1">
                            @(string.IsNullOrWhiteSpace(genre.Description) ? "Chưa có mô tả." : genre.Description)
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-light text-dark border">
                                <i class="fas fa-book-open me-1"></i>@(genre.Stories?.Count ?? 0) truyện
                            </span>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Story" asp-action="Index" asp-route-genreId="@genre.Id" class="btn btn-warning btn-sm rounded-pill flex-fill">
                                Xem truyện
                            </a>

                            <form asp-controller="Genre" asp-action="ToggleFavoriteGenre" method="post" class="flex-fill">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="genreId" value="@genre.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                                    Bỏ lưu
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state card border-0 shadow rounded-4 p-5 text-center">
            <i class="fas fa-star-half-alt fa-4x text-muted mb-3"></i>
            <h3 class="fw-bold">Bạn chưa có thể loại yêu thích</h3>
            <p class="text-muted">Hãy lưu các thể loại bạn quan tâm để truy cập nhanh hơn.</p>
            <div>
                <a asp-controller="Genre" asp-action="Index" class="btn btn-warning rounded-pill px-4">
                    Đến trang thể loại
                </a>
            </div>
        </div>
    }
</div>
