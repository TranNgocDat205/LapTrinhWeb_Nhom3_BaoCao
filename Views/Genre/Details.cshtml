@model DACS_Nhom3.Models.Genre
@using DACS_Nhom3.Models

@{
    ViewData["Title"] = Model.Name;
    var stories = ViewBag.Stories as List<Story> ?? new List<Story>();
}

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-4 shadow-sm">
            @TempData["Error"]
        </div>
    }

    <div class="genre-hero rounded-4 shadow-lg mb-5" style="--genre-color:@(Model.Color ?? "#E67E22")">
        <div class="genre-hero-content">
            <div class="genre-icon-big">
                <i class="@(string.IsNullOrEmpty(Model.Icon) ? "fas fa-book" : Model.Icon)"></i>
            </div>

            <div>
                <h1 class="fw-bold mb-2">@Model.Name</h1>
                <p class="mb-3 opacity-90">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Khám phá những bộ truyện hấp dẫn trong thể loại này." : Model.Description)
                </p>
                <span class="badge bg-light text-dark fs-6 px-3 py-2 rounded-pill">
                    <i class="fas fa-book-open me-1"></i> @stories.Count truyện
                </span>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">
            <i class="fas fa-list me-2 text-warning"></i>Truyện thuộc thể loại này
        </h2>

        <a asp-controller="Genre" asp-action="RandomToday" class="btn btn-warning rounded-pill px-4 shadow-sm">
            <i class="fas fa-dice me-1"></i> Random thể loại khác
        </a>
    </div>

    @if (stories.Any())
    {
        <div class="row g-4">
            @foreach (var story in stories)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="story-card h-100 shadow-sm" onclick="location.href='@Url.Action("Details", "Story", new { id = story.Id })'">
                        <div class="story-cover-wrap">
                            <img src="@(string.IsNullOrWhiteSpace(story.CoverImageUrl) ? "/images/default-cover.jpg" : story.CoverImageUrl)"
                                 alt="@story.Title"
                                 class="story-cover" />
                            <span class="story-badge">@Model.Name</span>
                        </div>

                        <div class="story-body">
                            <h5 class="story-title">@story.Title</h5>
                            <p class="story-desc">@story.Description</p>

                            <div class="story-meta">
                                <span><i class="fas fa-eye"></i> @story.Views</span>
                                <span><i class="fas fa-heart"></i> @story.Likes</span>
                            </div>

                            <a asp-controller="Story"
                               asp-action="Details"
                               asp-route-id="@story.Id"
                               class="btn btn-warning w-100 rounded-pill mt-3"
                               onclick="event.stopPropagation();">
                                Xem truyện
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state rounded-4 shadow-sm">
            <i class="fas fa-book-open fa-4x text-muted mb-3"></i>
            <h4>Chưa có truyện trong thể loại này</h4>
            <p class="text-muted">Bạn có thể quay lại sau hoặc random thể loại khác.</p>
            <a asp-controller="Genre" asp-action="RandomToday" class="btn btn-warning rounded-pill px-4">
                <i class="fas fa-dice me-1"></i> Random thể loại khác
            </a>
        </div>
    }
</div>

<style>
    .genre-hero {
        background: linear-gradient(135deg, var(--genre-color), #f59e0b);
        color: white;
        padding: 2.5rem;
        overflow: hidden;
    }

    .genre-hero-content {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .genre-icon-big {
        width: 110px;
        height: 110px;
        border-radius: 28px;
        background: rgba(255,255,255,.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        flex-shrink: 0;
    }

    .story-card {
        background: white;
        border-radius: 22px;
        overflow: hidden;
        cursor: pointer;
        transition: .25s ease;
    }

        .story-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0,0,0,.14) !important;
        }

    .story-cover-wrap {
        position: relative;
        height: 260px;
        background: #f1f5f9;
        overflow: hidden;
    }

    .story-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .story-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(245, 158, 11, .95);
        color: white;
        padding: .35rem .75rem;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 700;
    }

    .story-body {
        padding: 1.1rem;
    }

    .story-title {
        font-weight: 800;
        margin-bottom: .5rem;
        min-height: 48px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .story-desc {
        color: #64748b;
        font-size: .9rem;
        min-height: 44px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .story-meta {
        display: flex;
        justify-content: space-between;
        color: #64748b;
        font-size: .9rem;
    }

    .empty-state {
        background: white;
        padding: 4rem 2rem;
        text-align: center;
    }

    @@media (max-width: 768px) {
        .genre-hero-content {
            flex-direction: column;
            text-align: center;
        }
    }
</style>
