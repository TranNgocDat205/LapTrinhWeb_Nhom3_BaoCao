@model IEnumerable<DACS_Nhom3.Models.Genre>
@{
    ViewData["Title"] = "Quản lý thể loại";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <div>
                    <h2 class="fw-bold text-primary mb-1">
                        <i class="fas fa-tags me-2"></i> Quản lý thể loại
                    </h2>
                    <p class="text-muted mb-0">Quản lý danh sách thể loại truyện, thêm/sửa/xóa thể loại</p>
                </div>
                <button type="button" class="btn btn-primary btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createGenreModal">
                    <i class="fas fa-plus-circle me-2"></i> Thêm thể loại
                </button>
            </div>

            <!-- Alert -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- Bảng danh sách -->
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-gradient-primary text-white py-3 rounded-top-4">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-list fa-2x me-3"></i>
                            <div>
                                <h4 class="mb-0 fw-bold">Danh sách thể loại</h4>
                                <small class="opacity-75">Tổng số: @Model.Count() thể loại</small>
                            </div>
                        </div>
                        <div class="input-group w-auto">
                            <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm..." style="border-radius: 20px 0 0 20px;">
                            <button class="btn btn-light" onclick="searchTable()" style="border-radius: 0 20px 20px 0;">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="genreTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px">STT</th>
                                    <th style="width: 80px">Icon</th>
                                    <th>Tên thể loại</th>
                                    <th>Mô tả</th>
                                    <th style="width: 100px">Số truyện</th>
                                    <th style="width: 100px">Trạng thái</th>
                                    <th style="width: 120px">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var genre in Model.OrderBy(g => g.SortOrder))
                                {
                                    <tr id="row-@genre.Id">
                                        <td class="sort-order-cell">@genre.SortOrder</td>
                                        <td class="text-center">
                                            <div class="genre-icon-circle" style="background: @(genre.Color ?? "#E67E22")">
                                                <i class="@(string.IsNullOrEmpty(genre.Icon) ? "fas fa-book" : genre.Icon)"></i>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@genre.Name</td>
                                        <td class="text-muted">@(genre.Description?.Length > 50 ? genre.Description.Substring(0, 50) + "..." : genre.Description)</td>
                                        <td>
                                            <span class="badge bg-info rounded-pill px-3 py-2">@(genre.Stories?.Count ?? 0) truyện</span>
                                        </td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input toggle-status" type="checkbox"
                                                       data-id="@genre.Id"
                                                       @(genre.IsActive ? "checked" : "")>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-warning edit-genre"
                                                        data-id="@genre.Id"
                                                        data-name="@genre.Name"
                                                        data-description="@genre.Description"
                                                        data-icon="@genre.Icon"
                                                        data-color="@genre.Color"
                                                        data-sortorder="@genre.SortOrder"
                                                        data-isactive="@genre.IsActive.ToString().ToLower()"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#editGenreModal">
                                                    <i class="fas fa-edit"></i>
                                                </button>
                                                <button class="btn btn-danger delete-genre" data-id="@genre.Id">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Thêm thể loại - SỬA LẠI FORM -->
<div class="modal fade" id="createGenreModal" tabindex="-1" aria-labelledby="createGenreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-gradient-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold" id="createGenreModalLabel">
                    <i class="fas fa-plus-circle me-2"></i> Thêm thể loại mới
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="createGenreForm" method="post" action="@Url.Action("Create", "Genre")">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên thể loại <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="GenreName" class="form-control form-control-lg" placeholder="VD: Tiên Hiệp, Ngôn Tình, Kiếm Hiệp..." required />
                        <small class="text-muted">Tên thể loại sẽ hiển thị trên website</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả</label>
                        <textarea name="Description" id="GenreDescription" class="form-control" rows="3" placeholder="Mô tả về thể loại này..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Icon</label>
                            <input type="text" name="Icon" id="GenreIcon" class="form-control" placeholder="fas fa-book" value="fas fa-book" />
                            <small class="text-muted">Font Awesome class</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Màu sắc</label>
                            <input type="color" name="Color" id="GenreColor" class="form-control form-control-color" value="#E67E22" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thứ tự hiển thị</label>
                        <input type="number" name="SortOrder" id="GenreSortOrder" class="form-control" value="0" />
                        <small class="text-muted">Số càng nhỏ càng hiển thị lên đầu</small>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" id="GenreIsActive" class="form-check-input" value="true" checked />
                        <label class="form-check-label fw-bold">Kích hoạt thể loại</label>
                        <input type="hidden" name="IsActive" value="false" />
                        <small class="text-muted d-block">Nếu không kích hoạt, thể loại sẽ không hiển thị trên website</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Hủy
                    </button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" id="submitGenreBtn">
                        <i class="fas fa-save me-2"></i> Thêm thể loại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Sửa thể loại -->
<div class="modal fade" id="editGenreModal" tabindex="-1" aria-labelledby="editGenreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-gradient-warning text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold" id="editGenreModalLabel">
                    <i class="fas fa-edit me-2"></i> Chỉnh sửa thể loại
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="editGenreForm" method="post" action="@Url.Action("Edit", "Genre")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editGenreId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên thể loại <span class="text-danger">*</span></label>
                        <input type="text" name="Name" id="editGenreName" class="form-control form-control-lg" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả</label>
                        <textarea name="Description" id="editGenreDescription" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Icon</label>
                            <input type="text" name="Icon" id="editGenreIcon" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Màu sắc</label>
                            <input type="color" name="Color" id="editGenreColor" class="form-control form-control-color" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thứ tự hiển thị</label>
                        <input type="number" name="SortOrder" id="editGenreSortOrder" class="form-control" />
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" id="editGenreIsActive" class="form-check-input" value="true" />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label fw-bold">Kích hoạt thể loại</label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i> Hủy
                    </button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4">
                        <i class="fas fa-save me-2"></i> Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #2D3E50 0%, #1a2a3a 100%);
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #E67E22 0%, #d35400 100%);
    }

    .genre-icon-circle {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: white;
        font-size: 1.2rem;
        transition: all 0.3s;
    }

        .genre-icon-circle:hover {
            transform: scale(1.1);
        }

    .table tbody tr {
        transition: all 0.3s;
    }

        .table tbody tr:hover {
            background-color: #fff8f0;
        }

    .form-check-input:checked {
        background-color: #E67E22;
        border-color: #E67E22;
    }

    .btn-group .btn {
        border-radius: 8px;
        margin: 0 2px;
        transition: all 0.3s;
    }

        .btn-group .btn:hover {
            transform: translateY(-2px);
        }

    #searchInput {
        border-radius: 20px 0 0 20px;
        border: none;
        background: rgba(255,255,255,0.2);
        color: white;
    }

        #searchInput::placeholder {
            color: rgba(255,255,255,0.7);
        }

        #searchInput:focus {
            background: white;
            color: #333;
            box-shadow: none;
        }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const requestToken = tokenInput ? tokenInput.value : '';

        function closeModal(modalId) {
            const modalElement = document.getElementById(modalId);
            if (!modalElement || !window.bootstrap) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.hide();
        }

        function resetCreateButton() {
            const button = document.getElementById('submitGenreBtn');
            if (button) {
                button.innerHTML = '<i class="fas fa-save me-2"></i> Thêm thể loại';
                button.disabled = false;
            }
        }

        // Build FormData đúng cách: với cặp checkbox+hidden cùng tên,
        // chỉ lấy giá trị checkbox (true/false) thay vì gửi cả hai.
        function buildFormData(form) {
            const fd = new FormData();
            const checkboxNames = new Set();
            // Thu thập tên các checkbox
            form.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
                checkboxNames.add(cb.name);
                fd.append(cb.name, cb.checked ? 'true' : 'false');
            });
            // Thêm các field còn lại, bỏ qua hidden fields trùng tên với checkbox
            form.querySelectorAll('input:not([type="checkbox"]), textarea, select').forEach(function (el) {
                if (!el.name) return;
                if (el.type === 'hidden' && checkboxNames.has(el.name)) return; // bỏ hidden backup
                fd.append(el.name, el.value);
            });
            return fd;
        }

        async function postForm(url, form) {
            const controller = new AbortController();
            const timeoutId = setTimeout(function () { controller.abort(); }, 15000);

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: buildFormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    signal: controller.signal
                });

                const contentType = response.headers.get('content-type') || '';
                const data = contentType.includes('application/json')
                    ? await response.json()
                    : { success: false, message: await response.text() };

                if (!response.ok) {
                    throw new Error(data.message || 'Máy chủ trả về lỗi ' + response.status);
                }

                return data;
            } finally {
                clearTimeout(timeoutId);
            }
        }

        const createForm = document.getElementById('createGenreForm');
        if (createForm) {
            createForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const button = document.getElementById('submitGenreBtn');
                if (button) {
                    button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Đang xử lý...';
                    button.disabled = true;
                }

                try {
                    const response = await postForm(createForm.action, createForm);
                    if (response && response.success) {
                        closeModal('createGenreModal');
                        window.location.reload();
                        return;
                    }
                    alert((response && response.message) ? response.message : 'Không thể thêm thể loại!');
                } catch (error) {
                    alert(error.name === 'AbortError'
                        ? 'Gửi yêu cầu quá lâu. Vui lòng kiểm tra lại kết nối hoặc thử tải lại trang.'
                        : 'Có lỗi xảy ra: ' + error.message);
                } finally {
                    resetCreateButton();
                }
            });
        }

        const editForm = document.getElementById('editGenreForm');
        if (editForm) {
            editForm.addEventListener('submit', async function (e) {
                e.preventDefault();
                try {
                    const response = await postForm(editForm.action, editForm);
                    if (response && response.success) {
                        closeModal('editGenreModal');
                        window.location.reload();
                        return;
                    }
                    alert((response && response.message) ? response.message : 'Không thể cập nhật thể loại!');
                } catch (error) {
                    alert(error.name === 'AbortError'
                        ? 'Gửi yêu cầu quá lâu. Vui lòng thử lại.'
                        : 'Có lỗi xảy ra khi cập nhật: ' + error.message);
                }
            });
        }

        document.querySelectorAll('.delete-genre').forEach(function (button) {
            button.addEventListener('click', async function (e) {
                e.preventDefault();
                const id = this.dataset.id;
                const row = document.getElementById('row-' + id);
                const genreName = row ? row.querySelectorAll('td')[2].textContent.trim() : '';

                if (!confirm('Bạn có chắc chắn muốn xóa thể loại "' + genreName + '"?')) return;

                try {
                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('__RequestVerificationToken', requestToken);

                    const response = await fetch('/Genre/Delete', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': requestToken
                        }
                    });
                    const data = await response.json();

                    alert(data.message || (data.success ? 'Xóa thành công!' : 'Không thể xóa!'));
                    if (data.success && row) row.remove();
                } catch (error) {
                    alert('Có lỗi xảy ra khi xóa!');
                }
            });
        });

        document.querySelectorAll('.toggle-status').forEach(function (checkbox) {
            checkbox.addEventListener('change', async function () {
                const id = this.dataset.id;
                const currentCheckbox = this;

                try {
                    const formData = new FormData();
                    formData.append('id', id);
                    formData.append('__RequestVerificationToken', requestToken);

                    const response = await fetch('/Genre/ToggleStatus', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': requestToken
                        }
                    });
                    const data = await response.json();

                    if (!data.success) {
                        currentCheckbox.checked = !currentCheckbox.checked;
                        alert(data.message || 'Không thể đổi trạng thái!');
                    }
                } catch (error) {
                    currentCheckbox.checked = !currentCheckbox.checked;
                    alert('Có lỗi xảy ra!');
                }
            });
        });

        document.querySelectorAll('.edit-genre').forEach(function (button) {
            button.addEventListener('click', function () {
                document.getElementById('editGenreId').value = this.dataset.id || '';
                document.getElementById('editGenreName').value = this.dataset.name || '';
                document.getElementById('editGenreDescription').value = this.dataset.description || '';
                document.getElementById('editGenreIcon').value = this.dataset.icon || 'fas fa-book';
                document.getElementById('editGenreColor').value = this.dataset.color || '#E67E22';
                document.getElementById('editGenreSortOrder').value = this.dataset.sortorder || 0;
                document.getElementById('editGenreIsActive').checked = String(this.dataset.isactive) === 'true';
            });
        });

        window.searchTable = function () {
            const input = document.getElementById('searchInput');
            const filter = input.value.toLowerCase();
            const rows = document.querySelectorAll('#genreTable tbody tr');

            rows.forEach(function (row) {
                const nameCell = row.querySelectorAll('td')[2];
                const name = nameCell ? nameCell.textContent.toLowerCase() : '';
                row.style.display = name.includes(filter) ? '' : 'none';
            });
        };

        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') searchTable();
            });
        }
    });
</script>