@model IEnumerable<DACS_Nhom3.Models.Story>
@{
    ViewData["Title"] = "Thư viện truyện";
    var genres = ViewBag.Genres as List<DACS_Nhom3.Models.Genre>;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string sortBy = ViewBag.SortBy ?? "newest";
    string searchString = ViewBag.SearchString ?? "";
    int? currentGenre = ViewBag.CurrentGenre;
}

<div class="library-page">
    <!-- Page Header -->
    <div class="library-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="library-title"><i class="fas fa-book-open me-3"></i>Thư Viện Truyện</h1>
                    <p class="library-subtitle">Khám phá hàng ngàn câu chuyện hấp dẫn</p>
                </div>
                <div class="col-md-6">
                    <!-- Search Bar -->
                    <form method="get" asp-action="Index" class="search-form">
                        <div class="input-group">
                            <input type="text" name="searchString" value="@searchString"
                                   class="form-control search-input" placeholder="Tìm kiếm tên truyện...">
                            <input type="hidden" name="sortBy" value="@sortBy">
                            @if (currentGenre.HasValue)
                            {
                                <input type="hidden" name="genreId" value="@currentGenre">
                            }
                            <button class="btn btn-search" type="submit">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <div class="row">
            <!-- Sidebar: Filter -->
            <div class="col-lg-3 mb-4">
                <div class="filter-card">
                    <h5 class="filter-title"><i class="fas fa-filter me-2"></i>Bộ lọc</h5>

                    <!-- Sort -->
                    <div class="filter-section">
                        <label class="filter-label">Sắp xếp theo</label>
                        <div class="sort-buttons">
                            <a href="@Url.Action("Index", new { sortBy = "newest", genreId = currentGenre, searchString })"
                               class="sort-btn @(sortBy == "newest" ? "active" : "")">
                                <i class="fas fa-clock me-1"></i> Mới nhất
                            </a>
                            <a href="@Url.Action("Index", new { sortBy = "popular", genreId = currentGenre, searchString })"
                               class="sort-btn @(sortBy == "popular" ? "active" : "")">
                                <i class="fas fa-eye me-1"></i> Xem nhiều
                            </a>
                            <a href="@Url.Action("Index", new { sortBy = "likes", genreId = currentGenre, searchString })"
                               class="sort-btn @(sortBy == "likes" ? "active" : "")">
                                <i class="fas fa-heart me-1"></i> Yêu thích
                            </a>
                        </div>
                    </div>

                    <!-- Genres -->
                    <div class="filter-section">
                        <label class="filter-label">Thể loại</label>
                        <div class="genre-list">
                            <a href="@Url.Action("Index", new { sortBy, searchString })"
                               class="genre-filter-btn @(!currentGenre.HasValue ? "active" : "")">
                                <i class="fas fa-th me-1"></i> Tất cả
                            </a>
                            @if (genres != null)
                            {
                                foreach (var genre in genres)
                                {
                                    <a href="@Url.Action("Index", new { genreId = genre.Id, sortBy, searchString })"
                                       class="genre-filter-btn @(currentGenre == genre.Id ? "active" : "")">
                                        <i class="@(string.IsNullOrEmpty(genre.Icon) ? "fas fa-book" : genre.Icon) me-1"></i>
                                        @genre.Name
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-lg-9">
                @if (User.IsInRole("Admin"))
                {
                    <div class="admin-toolbar mb-4">
                        <div>
                            <strong><i class="fas fa-screwdriver-wrench me-2"></i>Quản trị truyện</strong>
                            <span>Thêm, sửa hoặc xóa truyện trong thư viện.</span>
                        </div>
                        <a asp-action="Create" class="admin-add-btn">
                            <i class="fas fa-plus-circle me-1"></i> Thêm truyện
                        </a>
                    </div>
                }

                @if (!string.IsNullOrEmpty(searchString))
                {
                    <div class="search-result-info mb-3">
                        <i class="fas fa-search me-2"></i>
                        Kết quả tìm kiếm cho: <strong>"@searchString"</strong>
                        — @Model.Count() truyện được tìm thấy
                        <a href="@Url.Action("Index", new { sortBy })" class="ms-2 clear-search">
                            <i class="fas fa-times"></i> Xóa
                        </a>
                    </div>
                }

                @if (Model != null && Model.Any())
                {
                    <div class="row g-4 story-grid">
                        @foreach (var story in Model)
                        {
                            <div class="col-xl-4 col-lg-4 col-md-6" data-aos="fade-up">
                                <div class="story-card h-100" onclick="location.href='@Url.Action("Details", "Story", new { id = story.Id })'" style="cursor:pointer;">
                                    <a href="@Url.Action("Details", "Story", new { id = story.Id })" class="story-card-link">
                                        <div class="story-card-img-wrapper">
                                            <img src="@(story.CoverImageUrl ?? "/images/default-cover.jpg")"
                                                 class="story-card-img" alt="@story.Title"
                                                 onerror="this.src='/images/default-cover.jpg'">
                                            <div class="story-card-overlay">
                                                <span class="read-now-btn"><i class="fas fa-list-ol me-1"></i>Xem tập</span>
                                            </div>
                                            <span class="story-genre-badge">@(story.Genre?.Name ?? "Chưa phân loại")</span>
                                            @{
                                                var episodeCountObj = ViewData[$"EpisodeCount_{story.Id}"];
                                                var episodeCount = episodeCountObj == null ? 1 : (int)episodeCountObj;
                                            }
                                            <span class="story-episode-badge">
                                                <i class="fas fa-layer-group me-1"></i>@episodeCount tập
                                            </span>
                                        </div>
                                    </a>
                                    <div class="story-card-body">
                                        <h3 class="story-title">
                                            <a href="@Url.Action("Details", "Story", new { id = story.Id })" onclick="event.stopPropagation();">@story.Title</a>
                                        </h3>
                                        <div class="story-author">
                                            <i class="fas fa-user-pen me-1"></i>
                                            @(string.IsNullOrEmpty(story.Author) ? "Không rõ" : story.Author)
                                        </div>
                                        <p class="story-description">
                                            @(story.Description?.Length > 90 ? story.Description.Substring(0, 90) + "..." : story.Description)
                                        </p>
                                        <div class="story-stats">
                                            <span><i class="fas fa-eye"></i> @story.Views</span>
                                            <span><i class="fas fa-heart"></i> @story.Likes</span>
                                            <span><i class="fas fa-comments"></i> @(story.Comments?.Count ?? 0)</span>
                                        </div>

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <div class="admin-story-actions" onclick="event.stopPropagation();">
                                                <a asp-action="Edit" asp-route-id="@story.Id" class="admin-action-btn edit-btn" title="Sửa truyện">
                                                    <i class="fas fa-pen"></i> Sửa
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@story.Id" class="admin-action-btn delete-btn" title="Xóa truyện">
                                                    <i class="fas fa-trash"></i> Xóa
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (totalPages > 1)
                    {
                        <nav class="mt-5 d-flex justify-content-center">
                            <ul class="pagination-custom">
                                @if (currentPage > 1)
                                {
                                    <li>
                                        <a href="@Url.Action("Index", new { page = currentPage - 1, sortBy, genreId = currentGenre, searchString })" class="page-btn">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li>
                                        <a href="@Url.Action("Index", new { page = i, sortBy, genreId = currentGenre, searchString })"
                                           class="page-btn @(i == currentPage ? "active" : "")">@i</a>
                                    </li>
                                }

                                @if (currentPage < totalPages)
                                {
                                    <li>
                                        <a href="@Url.Action("Index", new { page = currentPage + 1, sortBy, genreId = currentGenre, searchString })" class="page-btn">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-book-open fa-4x mb-4"></i>
                        <h4>Không tìm thấy truyện nào</h4>
                        <p>Thử tìm kiếm với từ khóa khác hoặc chọn thể loại khác.</p>
                        <a href="@Url.Action("Index")" class="btn-primary-custom mt-3">
                            <i class="fas fa-refresh me-2"></i>Xem tất cả
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

