@model IEnumerable<DACS_Nhom3.Models.Story>
@{
    ViewData["Title"] = "Truyện yêu thích";
}

<div class="container py-5 favorites-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="page-title fw-bold mb-1">
                <i class="fas fa-heart text-danger me-2"></i>Truyện yêu thích
            </h1>
            <p class="text-muted mb-0">Danh sách các truyện bạn đã lưu.</p>
        </div>

        <a asp-controller="Story" asp-action="Index" class="btn btn-warning rounded-pill px-4">
            <i class="fas fa-search me-1"></i>Khám phá thêm
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var story in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="favorite-card card border-0 shadow rounded-4 h-100 overflow-hidden">
                        <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="text-decoration-none">
                            <img src="@(story.CoverImageUrl ?? "/images/default-cover.jpg")"
                                 class="w-100"
                                 style="height:260px;object-fit:cover;"
                                 alt="@story.Title"
                                 onerror="this.src='/images/default-cover.jpg'" />
                        </a>

                        <div class="card-body">
                            <div class="mb-2">
                                @if (story.Genre != null)
                                {
                                    <span class="badge bg-warning text-dark">
                                        @(story.Genre.Name)
                                    </span>
                                }
                            </div>

                            <h5 class="fw-bold mb-2">
                                <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="text-decoration-none text-dark">
                                    @story.Title
                                </a>
                            </h5>

                            <p class="text-muted small mb-3">
                                <i class="fas fa-user-pen me-1"></i>@(string.IsNullOrWhiteSpace(story.Author) ? "Không rõ" : story.Author)
                            </p>

                            <div class="d-flex justify-content-between text-muted small mb-3">
                                <span><i class="fas fa-eye me-1"></i>@story.Views</span>
                                <span><i class="fas fa-heart me-1 text-danger"></i>@story.Likes</span>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="Story" asp-action="Details" asp-route-id="@story.Id" class="btn btn-warning btn-sm rounded-pill flex-fill">
                                    Xem
                                </a>

                                <form asp-controller="Story" asp-action="ToggleFavorite" method="post" class="flex-fill">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="storyId" value="@story.Id" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100">
                                        Bỏ lưu
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state card border-0 shadow rounded-4 p-5 text-center">
            <i class="fas fa-heart-broken fa-4x text-muted mb-3"></i>
            <h3 class="fw-bold">Bạn chưa có truyện yêu thích</h3>
            <p class="text-muted">Hãy lưu những truyện bạn thích để xem lại nhanh hơn.</p>
            <div>
                <a asp-controller="Story" asp-action="Index" class="btn btn-warning rounded-pill px-4">
                    Đến thư viện truyện
                </a>
            </div>
        </div>
    }
</div>
