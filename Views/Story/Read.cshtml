@model DACS_Nhom3.Models.Story
@{
    ViewData["Title"] = "Đọc truyện - " + Model.Title;
    var pdfUrl = ViewBag.PdfUrl as string;
    bool isPdfStory = !string.IsNullOrWhiteSpace(pdfUrl);
    int userDiamonds = ViewBag.UserDiamonds is int d ? d : 0;
    int downloadPrice = ViewBag.DownloadPrice is int p ? p : 5;
    bool canDownloadPdf = ViewBag.CanDownloadPdf is bool c && c;
}

<div class="container py-4 read-page">
    <div class="read-hero mb-4">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light btn-sm mb-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại chi tiết
            </a>
            <h1>@Model.Title</h1>
            <p class="mb-0">
                <i class="fas fa-user-pen me-1"></i>
                @(string.IsNullOrEmpty(Model.Author) ? "Không rõ tác giả" : Model.Author)
            </p>
        </div>

        @if (isPdfStory)
        {
            <div class="download-card">
                <div class="diamond-balance">
                    <span>Số kim cương của bạn</span>
                    <strong>@userDiamonds 💎</strong>
                </div>

                @if (canDownloadPdf)
                {
                    <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-download w-100">
                        <i class="fas fa-download me-1"></i> Tải truyện - @downloadPrice 💎
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-download-disabled w-100" id="openDiamondModalBtn">
                        <i class="fas fa-lock me-1"></i> Không đủ kim cương
                    </button>
                    <small class="text-warning d-block mt-2">
                        Bạn cần đủ @downloadPrice 💎 để tải truyện.
                    </small>
                }
            </div>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (isPdfStory)
    {
        <div id="pdfStatus" class="alert alert-info">
            <i class="fas fa-spinner fa-spin me-2"></i>Đang tải PDF...
        </div>
        <div id="pdfPages" class="pdf-pages"></div>

        <div id="pdfFallback" class="mt-3" style="display:none;">
            <div class="alert alert-warning">
                Không render được PDF bằng PDF.js. Trình duyệt sẽ mở bằng khung bên dưới.
            </div>
            <iframe src="@pdfUrl" class="pdf-frame" title="@Model.Title"></iframe>
        </div>
    }
    else
    {
        <div class="content-card story-content-text">
            @Html.Raw(Model.Content?.Replace("\n", "<br>") ?? "")
        </div>
    }
</div>

<div class="diamond-modal-overlay" id="notEnoughDiamondModal" aria-hidden="true">
    <div class="diamond-modal-box" role="dialog" aria-modal="true" aria-labelledby="diamondModalTitle">
        <button type="button" class="diamond-modal-close" id="closeDiamondModalX" aria-label="Đóng">&times;</button>
        <div class="text-center p-4">
            <div class="modal-icon mb-3">💎</div>
            <h4 id="diamondModalTitle">Không đủ kim cương</h4>
            <p class="text-muted mb-4">
                Bạn đang có <strong>@userDiamonds</strong> kim cương. Cần <strong>@downloadPrice</strong> kim cương để tải truyện này.
            </p>
            <button type="button" class="btn btn-primary px-4" id="closeDiamondModalBtn">Đã hiểu</button>
        </div>
    </div>
</div>

<style>
    .read-page h1 {
        font-weight: 800;
        font-size: clamp(1.6rem, 3vw, 2.6rem);
        margin-bottom: .5rem;
    }

    .read-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 22px;
        align-items: stretch;
        color: #fff;
        background: linear-gradient(135deg, #111827, #312e81, #7c2d12);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .25);
    }

    .download-card {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 20px;
        padding: 18px;
        backdrop-filter: blur(10px);
    }

    .diamond-balance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        font-size: .95rem;
    }

        .diamond-balance strong {
            font-size: 1.35rem;
            color: #fde68a;
        }

    .btn-download {
        background: linear-gradient(135deg, #f97316, #ef4444);
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 14px;
        padding: 12px 14px;
        box-shadow: 0 10px 24px rgba(239, 68, 68, .35);
    }

        .btn-download:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-download-disabled {
        background: #6b7280;
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 14px;
        padding: 12px 14px;
    }

    .content-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    .story-content-text {
        font-size: 1.08rem;
        line-height: 1.9;
        font-family: Georgia, serif;
    }

    .pdf-pages {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        background: #eef2ff;
        border-radius: 18px;
        padding: 18px;
        min-height: 60vh;
    }

    .pdf-page-wrap {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .pdf-page-number {
        color: #6c757d;
        font-size: .85rem;
    }

    .pdf-pages canvas {
        max-width: 100%;
        height: auto !important;
        background: white;
        box-shadow: 0 6px 20px rgba(0,0,0,.18);
        border-radius: 8px;
    }

    .pdf-frame {
        width: 100%;
        height: 90vh;
        border: 0;
        border-radius: 12px;
        background: white;
    }

    .diamond-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(15, 23, 42, .58);
        backdrop-filter: blur(3px);
    }

        .diamond-modal-overlay.show {
            display: flex;
        }

    .diamond-modal-box {
        position: relative;
        width: min(520px, 100%);
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .35);
        animation: diamondModalIn .18s ease-out;
    }

    .diamond-modal-close {
        position: absolute;
        top: 12px;
        right: 16px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #334155;
        font-size: 24px;
        line-height: 1;
    }

        .diamond-modal-close:hover {
            background: #e2e8f0;
        }

    @@keyframes diamondModalIn {
        from {
            transform: translateY(8px) scale(.98);
            opacity: 0;
        }

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        width: 72px;
        height: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff7ed;
        font-size: 2rem;
    }

    @@media (max-width: 768px) {
        .read-hero {
            grid-template-columns: 1fr;
            padding: 22px;
        }
    }
</style>

@section Scripts {
    @if (isPdfStory)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modal = document.getElementById('notEnoughDiamondModal');
                const openBtn = document.getElementById('openDiamondModalBtn');
                const closeBtn = document.getElementById('closeDiamondModalBtn');
                const closeX = document.getElementById('closeDiamondModalX');

                function openDiamondModal() {
                    if (!modal) return;
                    modal.classList.add('show');
                    modal.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                }

                function closeDiamondModal() {
                    if (!modal) return;
                    modal.classList.remove('show');
                    modal.setAttribute('aria-hidden', 'true');
                    document.body.style.overflow = '';
                }

                if (openBtn) openBtn.addEventListener('click', openDiamondModal);
                if (closeBtn) closeBtn.addEventListener('click', closeDiamondModal);
                if (closeX) closeX.addEventListener('click', closeDiamondModal);

                if (modal) {
                    modal.addEventListener('click', function (event) {
                        if (event.target === modal) closeDiamondModal();
                    });
                }

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') closeDiamondModal();
                });
            });
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pdfUrl));
                const status = document.getElementById('pdfStatus');
                const pagesContainer = document.getElementById('pdfPages');
                const fallback = document.getElementById('pdfFallback');

                function showFallback(message) {
                    if (status) {
                        status.className = 'alert alert-warning';
                        status.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>' + message;
                    }
                    if (pagesContainer) pagesContainer.style.display = 'none';
                    if (fallback) fallback.style.display = 'block';
                }

                if (!window.pdfjsLib) {
                    showFallback('Không tải được thư viện PDF.js.');
                    return;
                }

                pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

                pdfjsLib.getDocument(pdfUrl).promise.then(async function (pdf) {
                    if (status) status.innerHTML = '<i class="fas fa-file-pdf me-2"></i>Đang hiển thị ' + pdf.numPages + ' trang...';

                    for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
                        const page = await pdf.getPage(pageNumber);
                        const containerWidth = pagesContainer.clientWidth || 1000;
                        const originalViewport = page.getViewport({ scale: 1 });
                        const scale = Math.min(1.8, Math.max(0.6, (containerWidth - 36) / originalViewport.width));
                        const viewport = page.getViewport({ scale: scale });

                        const wrap = document.createElement('div');
                        wrap.className = 'pdf-page-wrap';

                        const label = document.createElement('div');
                        label.className = 'pdf-page-number';
                        label.textContent = 'Trang ' + pageNumber;

                        const canvas = document.createElement('canvas');
                        const context = canvas.getContext('2d');
                        canvas.width = viewport.width;
                        canvas.height = viewport.height;

                        wrap.appendChild(label);
                        wrap.appendChild(canvas);
                        pagesContainer.appendChild(wrap);

                        await page.render({ canvasContext: context, viewport: viewport }).promise;
                    }

                    if (status) status.style.display = 'none';
                }).catch(function (err) {
                    console.error(err);
                    showFallback('Không đọc được file PDF.');
                });
            });
        </script>
    }
}
