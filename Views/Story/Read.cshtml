@model DACS_Nhom3.Models.Story
@{
    ViewData["Title"] = "Đọc truyện - " + Model.Title;
    var pdfUrl = ViewBag.PdfUrl as string;
    bool isPdfStory = !string.IsNullOrWhiteSpace(pdfUrl);
    int userDiamonds = ViewBag.UserDiamonds is int d ? d : 0;
    int userGiftBoxes = ViewBag.UserGiftBoxes is int g ? g : 0;
    int downloadPrice = ViewBag.DownloadPrice is int p ? p : 5;
    int giftBoxPrice = ViewBag.GiftBoxPrice is int gb ? gb : 1;
    bool canDownloadPdf = ViewBag.CanDownloadPdf is bool c && c;
}

<div class="container py-4 read-page">
    <div class="read-hero mb-4">
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light btn-sm mb-3">
                <i class="fas fa-arrow-left me-1"></i> Quay lại chi tiết
            </a>
            <h1>@Model.Title</h1>
            <p class="mb-0">
                <i class="fas fa-user-pen me-1"></i>
                @(string.IsNullOrEmpty(Model.Author) ? "Không rõ tác giả" : Model.Author)
            </p>
        </div>

        @if (isPdfStory)
        {
            <div class="download-card">
                <div class="diamond-balance">
                    <span>Số kim cương của bạn</span>
                    <strong>@userDiamonds 💎</strong>
                </div>
                <div class="diamond-balance mt-2">
                    <span>Số hộp quà của bạn</span>
                    <strong>@userGiftBoxes 🎁</strong>
                </div>

                @if (canDownloadPdf)
                {
                    <a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-download w-100 mt-3">
                        <i class="fas fa-download me-1"></i> Tải truyện - @downloadPrice 💎 hoặc @giftBoxPrice 🎁
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-download-disabled w-100 mt-3" id="openDiamondModalBtn">
                        <i class="fas fa-lock me-1"></i> Không đủ kim cương hoặc hộp quà
                    </button>
                    <small class="text-warning d-block mt-2">
                        Bạn cần đủ @downloadPrice 💎 hoặc @giftBoxPrice 🎁 để tải truyện.
                    </small>
                }
            </div>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (isPdfStory)
    {
        <div id="pdfStatus" class="alert alert-info">
            <i class="fas fa-spinner fa-spin me-2"></i>Đang tải PDF...
        </div>

        <div id="pdfReader" class="pdf-reader" style="display:none;">
            <div class="pdf-reader-toolbar">
                <button type="button" class="btn btn-outline-light btn-sm" id="prevPageBtn">
                    <i class="fas fa-chevron-left me-1"></i> Trang trước
                </button>
                <div class="pdf-reader-counter">
                    Trang <span id="currentPageNumber">1</span>/<span id="totalPageNumber">?</span>
                </div>
                <button type="button" class="btn btn-outline-warning btn-sm pdf-fullscreen-btn" id="fullscreenBtn" title="Phóng to toàn màn hình (F11)">
                    <i class="fas fa-expand me-1" id="fullscreenIcon"></i> <span id="fullscreenText">Toàn màn hình</span>
                </button>
                <button type="button" class="btn btn-outline-light btn-sm" id="nextPageBtn">
                    Trang sau <i class="fas fa-chevron-right ms-1"></i>
                </button>
            </div>

            <div id="pdfBook" class="pdf-book pdf-spread-book" aria-live="polite">
                <div class="page-hotspot hotspot-prev" id="hotspotPrev" title="Trang trước" aria-label="Trang trước"></div>
                <div class="page-hotspot hotspot-next" id="hotspotNext" title="Trang sau" aria-label="Trang sau"></div>
                <div class="pdf-book-shadow"></div>
                <div class="pdf-spread-shell" id="pdfPageShell">
                    <div class="pdf-book-gutter"></div>

                    <div class="pdf-spread-layer pdf-current-spread" id="pdfCurrentSpread">
                        <div class="pdf-page-panel pdf-page-left">
                            <canvas id="pdfCanvasLeft" class="pdf-page-canvas"></canvas>
                        </div>
                        <div class="pdf-page-panel pdf-page-right">
                            <canvas id="pdfCanvasRight" class="pdf-page-canvas"></canvas>
                        </div>
                    </div>

                    <div class="pdf-spread-layer pdf-target-spread" id="pdfTargetSpread" aria-hidden="true">
                        <div class="pdf-page-panel pdf-page-left">
                            <canvas id="pdfNextCanvasLeft" class="pdf-page-canvas"></canvas>
                        </div>
                        <div class="pdf-page-panel pdf-page-right">
                            <canvas id="pdfNextCanvasRight" class="pdf-page-canvas"></canvas>
                        </div>
                    </div>

                    <div id="pdfFlipLayer" class="pdf-flip-layer" aria-hidden="true">
                        <div class="pdf-flip-face pdf-flip-front">
                            <canvas id="pdfFlipFrontCanvas" class="pdf-flip-canvas"></canvas>
                            <span class="pdf-paper-glow"></span>
                        </div>
                        <div class="pdf-flip-face pdf-flip-back">
                            <canvas id="pdfFlipBackCanvas" class="pdf-flip-canvas"></canvas>
                            <span class="pdf-paper-glow"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pdf-reader-hint">
                Hiển thị 2 trang như sách thật. Dùng nút, phím mũi tên, bấm mép trái/phải màn hình hoặc vuốt để lật từng cặp trang.
            </div>
        </div>

        <div id="pdfFallback" class="mt-3" style="display:none;">
            <div class="alert alert-warning">
                Không render được PDF bằng PDF.js. Trình duyệt sẽ mở bằng khung bên dưới.
            </div>
            <iframe src="@pdfUrl" class="pdf-frame" title="@Model.Title"></iframe>
        </div>
    }
    else
    {
        <div class="content-card story-content-text">
            @Html.Raw(Model.Content?.Replace("\n", "<br>") ?? "")
        </div>
    }
</div>

<div class="diamond-modal-overlay" id="notEnoughDiamondModal" aria-hidden="true">
    <div class="diamond-modal-box" role="dialog" aria-modal="true" aria-labelledby="diamondModalTitle">
        <button type="button" class="diamond-modal-close" id="closeDiamondModalX" aria-label="Đóng">&times;</button>
        <div class="text-center p-4">
            <div class="modal-icon mb-3">💎</div>
            <h4 id="diamondModalTitle">Không đủ kim cương hoặc hộp quà</h4>
            <p class="text-muted mb-4">
                Bạn đang có <strong>@userDiamonds</strong> kim cương và <strong>@userGiftBoxes</strong> hộp quà.
                Cần <strong>@downloadPrice</strong> kim cương hoặc <strong>@giftBoxPrice</strong> hộp quà để tải truyện này.
            </p>
            <button type="button" class="btn btn-primary px-4" id="closeDiamondModalBtn">Đã hiểu</button>
        </div>
    </div>
</div>

<style>
    .read-page {
        width: 100%;
        max-width: 100% !important;
        padding-left: clamp(6px, 1vw, 16px) !important;
        padding-right: clamp(6px, 1vw, 16px) !important;
    }

        .read-page h1 {
            font-weight: 800;
            font-size: clamp(1.6rem, 3vw, 2.6rem);
            margin-bottom: .5rem;
        }

    .read-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 22px;
        align-items: stretch;
        color: #fff;
        background: linear-gradient(135deg, #111827, #312e81, #7c2d12);
        border-radius: 24px;
        padding: 28px;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .25);
    }

    .download-card {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 20px;
        padding: 18px;
        backdrop-filter: blur(10px);
    }

    .diamond-balance {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        font-size: .95rem;
    }

        .diamond-balance strong {
            font-size: 1.35rem;
            color: #fde68a;
        }

    .btn-download {
        background: linear-gradient(135deg, #f97316, #ef4444);
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 14px;
        padding: 12px 14px;
        box-shadow: 0 10px 24px rgba(239, 68, 68, .35);
    }

        .btn-download:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .btn-download-disabled {
        background: #6b7280;
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 14px;
        padding: 12px 14px;
    }

    .content-card {
        background: #fff;
        border-radius: 18px;
        padding: 28px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    .story-content-text {
        font-size: 1.08rem;
        line-height: 1.9;
        font-family: Georgia, serif;
    }

    .pdf-reader {
        background: radial-gradient(circle at top, #1f2937, #0f172a 72%);
        border-radius: 24px;
        padding: 8px;
        min-height: calc(100vh - 24px);
        width: 100%;
        box-shadow: 0 22px 50px rgba(15, 23, 42, .25);
        display: flex;
        flex-direction: column;
    }

    .pdf-reader-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #fff;
        margin-bottom: 12px;
        flex: 0 0 auto;
    }

    .pdf-reader-counter {
        min-width: 120px;
        text-align: center;
        font-weight: 800;
        color: #fde68a;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 999px;
        padding: 7px 14px;
    }

    .pdf-fullscreen-btn {
        font-weight: 800;
        border-radius: 999px;
        padding: 7px 14px;
        white-space: nowrap;
        box-shadow: 0 8px 22px rgba(0,0,0,.18);
    }

    .pdf-reader:fullscreen,
    .pdf-reader:-webkit-full-screen {
        width: 100vw;
        height: 100vh;
        min-height: 100vh;
        padding: 8px;
        border-radius: 0;
        background: radial-gradient(circle at top, #1f2937, #020617 78%);
    }

        .pdf-reader:fullscreen .pdf-book,
        .pdf-reader:-webkit-full-screen .pdf-book {
            height: calc(100vh - 58px);
            min-height: calc(100vh - 58px);
            border-radius: 12px;
            padding: 2px;
        }

        .pdf-reader:fullscreen .pdf-reader-hint,
        .pdf-reader:-webkit-full-screen .pdf-reader-hint {
            display: none;
        }

        .pdf-reader:fullscreen .pdf-reader-toolbar,
        .pdf-reader:-webkit-full-screen .pdf-reader-toolbar {
            margin-bottom: 6px;
            padding: 0 4px;
        }

        .pdf-reader:fullscreen .pdf-spread-shell,
        .pdf-reader:-webkit-full-screen .pdf-spread-shell {
            max-width: 99vw;
            max-height: calc(100vh - 66px);
        }

    .pdf-book {
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        perspective: 2800px;
        overflow: hidden;
        padding: 4px;
        flex: 1 1 auto;
        width: 100%;
        min-height: calc(100vh - 82px);
        height: calc(100vh - 82px);
        background: radial-gradient(circle at center, rgba(255,255,255,.10), transparent 58%), linear-gradient(135deg, rgba(255,255,255,.06), transparent 42%, rgba(0,0,0,.18));
        border-radius: 18px;
    }

    .page-hotspot {
        position: absolute;
        top: 0;
        height: 100%;
        width: 18%;
        z-index: 60;
        cursor: pointer;
        opacity: 0;
        transition: opacity .24s ease, background .24s ease;
        -webkit-tap-highlight-color: transparent;
    }

    .hotspot-prev {
        left: 0;
        background: linear-gradient(to right, rgba(255,255,255,.10), transparent);
    }

    .hotspot-next {
        right: 0;
        background: linear-gradient(to left, rgba(255,255,255,.10), transparent);
    }

    .page-hotspot::after {
        position: absolute;
        top: 50%;
        transform: translateY(-50%) scale(.92);
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: rgba(15,23,42,.46);
        color: #fff;
        font-size: 30px;
        font-weight: 900;
        box-shadow: 0 12px 30px rgba(0,0,0,.28);
        backdrop-filter: blur(8px);
        transition: transform .24s ease, opacity .24s ease;
        opacity: 0;
    }

    .hotspot-prev::after {
        content: '❮';
        left: 22px;
    }

    .hotspot-next::after {
        content: '❯';
        right: 22px;
    }

    .page-hotspot:hover {
        opacity: 1;
    }

        .page-hotspot:hover::after {
            opacity: 1;
            transform: translateY(-50%) scale(1);
        }

    .pdf-book-shadow {
        position: absolute;
        width: min(92%, 1200px);
        height: 44px;
        bottom: 20px;
        border-radius: 50%;
        background: radial-gradient(ellipse at center, rgba(0,0,0,.45), transparent 70%);
        filter: blur(8px);
        pointer-events: none;
    }

    .pdf-spread-shell {
        --spread-width: 98vw;
        --spread-height: 90vh;
        position: relative;
        width: var(--spread-width);
        height: var(--spread-height);
        max-width: min(98vw, 1900px);
        max-height: 92vh;
        transform-style: preserve-3d;
        border-radius: 18px;
        background: #f8fafc;
        box-shadow: 0 34px 90px rgba(0,0,0,.52), 0 0 0 1px rgba(255,255,255,.18);
        overflow: hidden;
        isolation: isolate;
        transition: transform .32s ease, box-shadow .32s ease;
    }

        .pdf-spread-shell.is-turning {
            transform: translateY(-3px) scale(1.006);
            box-shadow: 0 44px 108px rgba(0,0,0,.62), 0 0 0 1px rgba(255,255,255,.22);
        }

    .pdf-spread-layer {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        z-index: 1;
    }

    .pdf-target-spread {
        z-index: 0;
        opacity: 0;
        transform: scale(.985);
        transition: opacity .34s ease, transform .34s ease;
        pointer-events: none;
    }

    .pdf-spread-shell.prepare-next .pdf-target-spread,
    .pdf-spread-shell.prepare-prev .pdf-target-spread {
        opacity: 1;
        transform: scale(1);
    }

    .pdf-page-panel {
        position: relative;
        height: 100%;
        overflow: hidden;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pdf-page-left {
        border-radius: 18px 0 0 18px;
        box-shadow: inset -18px 0 28px rgba(15,23,42,.10), inset -1px 0 0 rgba(15,23,42,.16);
    }

    .pdf-page-right {
        border-radius: 0 18px 18px 0;
        box-shadow: inset 18px 0 28px rgba(15,23,42,.10), inset 1px 0 0 rgba(15,23,42,.16);
    }

    .pdf-book-gutter {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 34px;
        transform: translateX(-50%);
        z-index: 6;
        pointer-events: none;
        background: linear-gradient(90deg, rgba(0,0,0,.20), rgba(255,255,255,.25) 47%, rgba(0,0,0,.18)), radial-gradient(ellipse at center, rgba(0,0,0,.18), transparent 72%);
        mix-blend-mode: multiply;
        opacity: .58;
    }

    .pdf-spread-shell.is-turning .pdf-book-gutter {
        opacity: .86;
        transition: opacity .32s ease;
    }

    .pdf-page-canvas {
        display: block;
        max-width: 100%;
        max-height: 100%;
        background: #fff;
        backface-visibility: hidden;
    }

    .pdf-page-panel.is-empty::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #f8fafc, #ffffff), repeating-linear-gradient(0deg, transparent 0 30px, rgba(15,23,42,.035) 30px 31px);
    }

    .pdf-page-panel.is-empty::after {
        content: "Hết trang";
        position: relative;
        z-index: 1;
        color: #94a3b8;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .pdf-flip-layer {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 50%;
        z-index: 8;
        display: none;
        transform-style: preserve-3d;
        backface-visibility: hidden;
        pointer-events: none;
        will-change: transform, filter;
        filter: drop-shadow(-14px 0 24px rgba(0,0,0,.24));
    }

    .pdf-spread-shell.is-turning .pdf-flip-layer {
        display: block;
    }

    .pdf-spread-shell.flip-right .pdf-flip-layer {
        left: 50%;
        transform-origin: left center;
        animation: pageTurnRight 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .pdf-spread-shell.flip-left .pdf-flip-layer {
        left: 0;
        transform-origin: right center;
        animation: pageTurnLeft 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .pdf-flip-face {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background: #fff;
        backface-visibility: hidden;
        transform-style: preserve-3d;
    }

    .pdf-spread-shell.flip-right .pdf-flip-face {
        border-radius: 0 18px 18px 0;
    }

    .pdf-spread-shell.flip-left .pdf-flip-face {
        border-radius: 18px 0 0 18px;
    }

    .pdf-flip-front {
        transform: rotateY(0deg) translateZ(.8px);
    }

    .pdf-flip-back {
        transform: rotateY(180deg) translateZ(.8px);
    }

    .pdf-flip-canvas {
        display: block;
        width: 100%;
        height: 100%;
        background: #fff;
    }

    .pdf-paper-glow,
    .pdf-flip-face::after {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
    }

    .pdf-paper-glow {
        background: linear-gradient(100deg, rgba(255,255,255,.34), transparent 34%, rgba(0,0,0,.10) 78%);
        opacity: .38;
        mix-blend-mode: multiply;
    }

    .pdf-spread-shell.flip-right .pdf-flip-front::after,
    .pdf-spread-shell.flip-left .pdf-flip-front::after {
        background: linear-gradient(90deg, rgba(255,255,255,.08), rgba(0,0,0,.18) 54%, rgba(0,0,0,.56));
        animation: frontPageShade 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .pdf-spread-shell.flip-right .pdf-flip-back::after,
    .pdf-spread-shell.flip-left .pdf-flip-back::after {
        background: linear-gradient(90deg, rgba(0,0,0,.48), rgba(255,255,255,.08) 58%, rgba(255,255,255,.34));
        animation: backPageShade 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @@keyframes pageTurnRight {
        0% {
            transform: rotateY(0deg) translateX(0) scaleX(1);
            filter: brightness(1);
        }

        22% {
            transform: rotateY(-38deg) translateX(-6px) scaleX(.992);
            filter: brightness(.98);
        }

        50% {
            transform: rotateY(-112deg) translateX(-14px) scaleX(.965);
            filter: brightness(.82);
        }

        78% {
            transform: rotateY(-164deg) translateX(-5px) scaleX(.992);
            filter: brightness(.96);
        }

        100% {
            transform: rotateY(-180deg) translateX(0) scaleX(1);
            filter: brightness(1);
        }
    }

    @@keyframes pageTurnLeft {
        0% {
            transform: rotateY(0deg) translateX(0) scaleX(1);
            filter: brightness(1);
        }

        22% {
            transform: rotateY(38deg) translateX(6px) scaleX(.992);
            filter: brightness(.98);
        }

        50% {
            transform: rotateY(112deg) translateX(14px) scaleX(.965);
            filter: brightness(.82);
        }

        78% {
            transform: rotateY(164deg) translateX(5px) scaleX(.992);
            filter: brightness(.96);
        }

        100% {
            transform: rotateY(180deg) translateX(0) scaleX(1);
            filter: brightness(1);
        }
    }

    @@keyframes frontPageShade {
        0%, 100% {
            opacity: 0;
        }

        45% {
            opacity: .76;
        }

        62% {
            opacity: .62;
        }
    }

    @@keyframes backPageShade {
        0% {
            opacity: .82;
        }

        48% {
            opacity: .52;
        }

        100% {
            opacity: 0;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pdf-spread-shell.flip-right .pdf-flip-layer,
        .pdf-spread-shell.flip-left .pdf-flip-layer,
        .pdf-spread-shell.flip-right .pdf-flip-front::after,
        .pdf-spread-shell.flip-left .pdf-flip-front::after,
        .pdf-spread-shell.flip-right .pdf-flip-back::after,
        .pdf-spread-shell.flip-left .pdf-flip-back::after {
            animation-duration: .01ms !important;
        }
    }

    .pdf-reader-hint {
        color: rgba(255,255,255,.72);
        font-size: .9rem;
        text-align: center;
        margin-top: 10px;
        flex: 0 0 auto;
    }

    @@media (max-width: 768px) {
        .pdf-reader {
            border-radius: 16px;
            padding: 6px;
            min-height: calc(100vh - 20px);
        }

        .pdf-reader-toolbar {
            flex-wrap: wrap;
        }

        .pdf-reader-counter {
            order: -1;
            width: 100%;
        }

        .pdf-reader-toolbar .btn {
            flex: 1 1 0;
        }

        .pdf-fullscreen-btn span {
            display: none;
        }

        .pdf-book {
            min-height: calc(100vh - 158px);
            padding: 4px;
        }

        .page-hotspot {
            width: 26%;
        }

            .page-hotspot::after {
                display: none;
            }

        .pdf-spread-shell {
            border-radius: 14px;
        }

        .pdf-page-left,
        .pdf-page-right {
            border-radius: 14px;
        }
    }

    .pdf-frame {
        width: 100%;
        height: 90vh;
        border: 0;
        border-radius: 12px;
        background: white;
    }

    .diamond-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(15, 23, 42, .58);
        backdrop-filter: blur(3px);
    }

        .diamond-modal-overlay.show {
            display: flex;
        }

    .diamond-modal-box {
        position: relative;
        width: min(520px, 100%);
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .35);
        animation: diamondModalIn .18s ease-out;
    }

    .diamond-modal-close {
        position: absolute;
        top: 12px;
        right: 16px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #334155;
        font-size: 24px;
        line-height: 1;
    }

        .diamond-modal-close:hover {
            background: #e2e8f0;
        }

    @@keyframes diamondModalIn {
        from {
            transform: translateY(8px) scale(.98);
            opacity: 0;
        }

        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        width: 72px;
        height: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff7ed;
        font-size: 2rem;
    }

    @@media (max-width: 768px) {
        .read-hero {
            grid-template-columns: 1fr;
            padding: 22px;
        }
    }
</style>

@section Scripts {
    @if (isPdfStory)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const modal = document.getElementById('notEnoughDiamondModal');
                const openBtn = document.getElementById('openDiamondModalBtn');
                const closeBtn = document.getElementById('closeDiamondModalBtn');
                const closeX = document.getElementById('closeDiamondModalX');

                function openDiamondModal() {
                    if (!modal) return;
                    modal.classList.add('show');
                    modal.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                }

                function closeDiamondModal() {
                    if (!modal) return;
                    modal.classList.remove('show');
                    modal.setAttribute('aria-hidden', 'true');
                    document.body.style.overflow = '';
                }

                if (openBtn) openBtn.addEventListener('click', openDiamondModal);
                if (closeBtn) closeBtn.addEventListener('click', closeDiamondModal);
                if (closeX) closeX.addEventListener('click', closeDiamondModal);

                if (modal) {
                    modal.addEventListener('click', function (event) {
                        if (event.target === modal) closeDiamondModal();
                    });
                }

                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape') closeDiamondModal();
                });
            });
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const pdfUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pdfUrl));
                const status = document.getElementById('pdfStatus');
                const reader = document.getElementById('pdfReader');
                const fallback = document.getElementById('pdfFallback');
                const pageShell = document.getElementById('pdfPageShell');
                const currentLeftCanvas = document.getElementById('pdfCanvasLeft');
                const currentRightCanvas = document.getElementById('pdfCanvasRight');
                const nextLeftCanvas = document.getElementById('pdfNextCanvasLeft');
                const nextRightCanvas = document.getElementById('pdfNextCanvasRight');
                const flipFrontCanvas = document.getElementById('pdfFlipFrontCanvas');
                const flipBackCanvas = document.getElementById('pdfFlipBackCanvas');
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                const fullscreenBtn = document.getElementById('fullscreenBtn');
                const fullscreenIcon = document.getElementById('fullscreenIcon');
                const fullscreenText = document.getElementById('fullscreenText');
                const currentPageNumber = document.getElementById('currentPageNumber');
                const totalPageNumber = document.getElementById('totalPageNumber');

                let pdfDoc = null;
                let currentStartPage = 1;
                let isRendering = false;
                let pendingSpread = null;
                let lastSpreadSize = { width: 960, height: 680, pageWidth: 480, pageHeight: 680 };

                function showFallback(message) {
                    if (status) {
                        status.className = 'alert alert-warning';
                        status.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>' + message;
                    }
                    if (reader) reader.style.display = 'none';
                    if (fallback) fallback.style.display = 'block';
                }

                function getRightPage(startPage) {
                    return startPage + 1 <= pdfDoc.numPages ? startPage + 1 : null;
                }

                function isPdfFullscreen() {
                    return document.fullscreenElement === reader ||
                        document.webkitFullscreenElement === reader;
                }

                function updateFullscreenButton() {
                    if (!fullscreenBtn) return;

                    const active = isPdfFullscreen();
                    fullscreenBtn.classList.toggle('btn-warning', active);
                    fullscreenBtn.classList.toggle('btn-outline-warning', !active);

                    if (fullscreenIcon) {
                        fullscreenIcon.classList.toggle('fa-expand', !active);
                        fullscreenIcon.classList.toggle('fa-compress', active);
                    }

                    if (fullscreenText) {
                        fullscreenText.textContent = active ? 'Thoát toàn màn hình' : 'Toàn màn hình';
                    }
                }

                async function toggleFullscreen() {
                    if (!reader) return;

                    try {
                        if (isPdfFullscreen()) {
                            if (document.exitFullscreen) await document.exitFullscreen();
                            else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
                        } else {
                            if (reader.requestFullscreen) await reader.requestFullscreen();
                            else if (reader.webkitRequestFullscreen) reader.webkitRequestFullscreen();
                        }
                    } catch (err) {
                        console.warn('Không thể bật chế độ toàn màn hình:', err);
                    }

                    setTimeout(function () {
                        updateFullscreenButton();
                        renderSpread(currentStartPage, null);
                    }, 180);
                }

                function updateControls() {
                    if (!pdfDoc) return;
                    const rightPage = getRightPage(currentStartPage);
                    currentPageNumber.textContent = rightPage ? `${currentStartPage}-${rightPage}` : `${currentStartPage}`;
                    totalPageNumber.textContent = pdfDoc.numPages;
                    prevBtn.disabled = currentStartPage <= 1 || isRendering;
                    nextBtn.disabled = currentStartPage + 2 > pdfDoc.numPages || isRendering;
                }

                function getReaderBounds() {
                    const book = document.getElementById('pdfBook');
                    const toolbar = document.querySelector('.pdf-reader-toolbar');
                    const hint = document.querySelector('.pdf-reader-hint');
                    const toolbarHeight = toolbar ? toolbar.offsetHeight : 0;
                    const hintHeight = hint ? hint.offsetHeight : 0;

                    const bookRect = book
                        ? book.getBoundingClientRect()
                        : { width: window.innerWidth, height: window.innerHeight - toolbarHeight - hintHeight - 24 };

                    const fullscreen = isPdfFullscreen();
                    const sidePadding = fullscreen ? 2 : (window.innerWidth <= 768 ? 4 : 8);
                    const widthRatio = fullscreen ? .995 : .985;
                    const heightRatio = fullscreen ? .965 : .91;
                    const availableWidth = Math.max(360, Math.min(bookRect.width - sidePadding, window.innerWidth * widthRatio));
                    const availableHeight = Math.max(420, Math.min(bookRect.height - sidePadding, window.innerHeight * heightRatio));

                    return { availableWidth, availableHeight };
                }

                function clearPanel(targetCanvas) {
                    const panel = targetCanvas.closest('.pdf-page-panel');
                    if (panel) panel.classList.add('is-empty');
                    targetCanvas.width = 1;
                    targetCanvas.height = 1;
                    targetCanvas.style.width = '1px';
                    targetCanvas.style.height = '1px';
                }

                function markPanelReady(targetCanvas) {
                    const panel = targetCanvas.closest('.pdf-page-panel');
                    if (panel) panel.classList.remove('is-empty');
                }

                function applyCanvasSize(targetCanvas, cssWidth, cssHeight, viewport) {
                    targetCanvas.width = Math.floor(viewport.width);
                    targetCanvas.height = Math.floor(viewport.height);
                    targetCanvas.style.width = cssWidth + 'px';
                    targetCanvas.style.height = cssHeight + 'px';
                }

                function syncShellSize(width, height) {
                    lastSpreadSize.width = width;
                    lastSpreadSize.height = height;
                    lastSpreadSize.pageWidth = width / 2;
                    lastSpreadSize.pageHeight = height;
                    pageShell.style.setProperty('--spread-width', width + 'px');
                    pageShell.style.setProperty('--spread-height', height + 'px');
                }

                function copyCanvas(sourceCanvas, targetCanvas) {
                    targetCanvas.width = sourceCanvas.width;
                    targetCanvas.height = sourceCanvas.height;
                    targetCanvas.style.width = '100%';
                    targetCanvas.style.height = '100%';
                    const targetContext = targetCanvas.getContext('2d', { alpha: false });
                    targetContext.fillStyle = '#fff';
                    targetContext.fillRect(0, 0, targetCanvas.width, targetCanvas.height);
                    if (sourceCanvas.width > 1 && sourceCanvas.height > 1) {
                        targetContext.drawImage(sourceCanvas, 0, 0, targetCanvas.width, targetCanvas.height);
                    }
                }

                async function getPageFitScale(pageNumber) {
                    const page = await pdfDoc.getPage(pageNumber);
                    const viewport = page.getViewport({ scale: 1 });
                    const bounds = getReaderBounds();
                    const pageGap = 0;
                    const pageWidthLimit = (bounds.availableWidth - pageGap) / 2;
                    const widthScale = pageWidthLimit / viewport.width;
                    const heightScale = bounds.availableHeight / viewport.height;
                    const cssScale = Math.min(widthScale, heightScale, 5);
                    const cssWidth = Math.floor(viewport.width * cssScale);
                    const cssHeight = Math.floor(viewport.height * cssScale);
                    return { page, viewport, cssScale, cssWidth, cssHeight };
                }

                function detectContentBounds(canvas) {
                    const ctx = canvas.getContext('2d', { willReadFrequently: true });
                    const width = canvas.width;
                    const height = canvas.height;
                    const imageData = ctx.getImageData(0, 0, width, height).data;
                    const step = Math.max(2, Math.floor(Math.min(width, height) / 900));
                    let minX = width, minY = height, maxX = 0, maxY = 0;

                    for (let y = 0; y < height; y += step) {
                        for (let x = 0; x < width; x += step) {
                            const index = (y * width + x) * 4;
                            const r = imageData[index];
                            const g = imageData[index + 1];
                            const b = imageData[index + 2];
                            const a = imageData[index + 3];
                            const isContent = a > 20 && (r < 245 || g < 245 || b < 245);

                            if (isContent) {
                                if (x < minX) minX = x;
                                if (y < minY) minY = y;
                                if (x > maxX) maxX = x;
                                if (y > maxY) maxY = y;
                            }
                        }
                    }

                    if (minX >= maxX || minY >= maxY) {
                        return { x: 0, y: 0, width, height };
                    }

                    const padding = Math.max(12, Math.floor(Math.min(width, height) * .012));
                    minX = Math.max(0, minX - padding);
                    minY = Math.max(0, minY - padding);
                    maxX = Math.min(width, maxX + padding);
                    maxY = Math.min(height, maxY + padding);

                    const cropWidth = maxX - minX;
                    const cropHeight = maxY - minY;
                    const tooSmall = cropWidth < width * .25 || cropHeight < height * .25;
                    if (tooSmall) return { x: 0, y: 0, width, height };

                    return { x: minX, y: minY, width: cropWidth, height: cropHeight };
                }

                function copyCroppedCanvas(sourceCanvas, targetCanvas, bounds, maxCssWidth, maxCssHeight) {
                    targetCanvas.width = bounds.width;
                    targetCanvas.height = bounds.height;

                    const cropRatio = bounds.width / bounds.height;
                    const panelRatio = maxCssWidth / maxCssHeight;
                    let displayWidth;
                    let displayHeight;

                    if (cropRatio > panelRatio) {
                        displayWidth = maxCssWidth;
                        displayHeight = maxCssWidth / cropRatio;
                    } else {
                        displayHeight = maxCssHeight;
                        displayWidth = maxCssHeight * cropRatio;
                    }

                    targetCanvas.style.width = Math.floor(displayWidth) + 'px';
                    targetCanvas.style.height = Math.floor(displayHeight) + 'px';

                    const targetContext = targetCanvas.getContext('2d', { alpha: false });
                    targetContext.fillStyle = '#fff';
                    targetContext.fillRect(0, 0, targetCanvas.width, targetCanvas.height);
                    targetContext.drawImage(
                        sourceCanvas,
                        bounds.x,
                        bounds.y,
                        bounds.width,
                        bounds.height,
                        0,
                        0,
                        bounds.width,
                        bounds.height
                    );
                }

                async function renderPdfPageToCanvas(pageNumber, targetCanvas, cssScale, cssWidth, cssHeight) {
                    if (!pageNumber || pageNumber > pdfDoc.numPages) {
                        clearPanel(targetCanvas);
                        return;
                    }

                    const page = await pdfDoc.getPage(pageNumber);
                    const outputScale = Math.min(window.devicePixelRatio || 1, 2.2);
                    const viewport = page.getViewport({ scale: cssScale * outputScale });
                    const tempCanvas = document.createElement('canvas');
                    const tempContext = tempCanvas.getContext('2d', { alpha: false });

                    tempCanvas.width = Math.floor(viewport.width);
                    tempCanvas.height = Math.floor(viewport.height);
                    tempContext.save();
                    tempContext.fillStyle = '#fff';
                    tempContext.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
                    tempContext.restore();

                    await page.render({ canvasContext: tempContext, viewport: viewport }).promise;

                    markPanelReady(targetCanvas);
                    const cropBounds = detectContentBounds(tempCanvas);
                    copyCroppedCanvas(tempCanvas, targetCanvas, cropBounds, cssWidth, cssHeight);
                }

                async function renderSpreadToCanvases(startPage, leftCanvas, rightCanvas) {
                    const fit = await getPageFitScale(startPage);
                    const spreadWidth = fit.cssWidth * 2;
                    const spreadHeight = fit.cssHeight;
                    syncShellSize(spreadWidth, spreadHeight);
                    await Promise.all([
                        renderPdfPageToCanvas(startPage, leftCanvas, fit.cssScale, fit.cssWidth, fit.cssHeight),
                        renderPdfPageToCanvas(startPage + 1, rightCanvas, fit.cssScale, fit.cssWidth, fit.cssHeight)
                    ]);
                }

                function waitForTurnAnimation() {
                    return new Promise(resolve => {
                        if (!pageShell) return resolve();

                        let completed = false;
                        const finish = () => {
                            if (completed) return;
                            completed = true;
                            pageShell.removeEventListener('animationend', onAnimationEnd);
                            resolve();
                        };
                        const onAnimationEnd = event => {
                            if (event.target && event.target.id === 'pdfFlipLayer') finish();
                        };

                        pageShell.addEventListener('animationend', onAnimationEnd);
                        setTimeout(finish, 840);
                    });
                }

                async function animateTurn(direction) {
                    if (!pageShell || !direction) return;

                    if (direction === 'next') {
                        copyCanvas(currentRightCanvas, flipFrontCanvas);
                        copyCanvas(nextLeftCanvas, flipBackCanvas);
                    } else {
                        copyCanvas(currentLeftCanvas, flipFrontCanvas);
                        copyCanvas(nextRightCanvas, flipBackCanvas);
                    }

                    pageShell.classList.remove('flip-right', 'flip-left', 'prepare-next', 'prepare-prev', 'is-turning');
                    void pageShell.offsetWidth;
                    pageShell.classList.add(direction === 'prev' ? 'prepare-prev' : 'prepare-next');
                    pageShell.classList.add('is-turning', direction === 'prev' ? 'flip-left' : 'flip-right');

                    await waitForTurnAnimation();

                    pageShell.classList.remove('flip-right', 'flip-left', 'prepare-next', 'prepare-prev', 'is-turning');
                }

                function copySpreadToCurrent() {
                    copyCanvas(nextLeftCanvas, currentLeftCanvas);
                    copyCanvas(nextRightCanvas, currentRightCanvas);

                    [nextLeftCanvas, nextRightCanvas, currentLeftCanvas, currentRightCanvas].forEach(canvasItem => {
                        const panel = canvasItem.closest('.pdf-page-panel');
                        if (canvasItem.width <= 1 || canvasItem.height <= 1) panel?.classList.add('is-empty');
                        else panel?.classList.remove('is-empty');
                    });
                }

                async function renderSpread(startPage, direction) {
                    if (!pdfDoc || isRendering) {
                        pendingSpread = { startPage, direction };
                        return;
                    }

                    isRendering = true;
                    updateControls();

                    try {
                        if (!direction || startPage === currentStartPage || currentLeftCanvas.width === 0) {
                            await renderSpreadToCanvases(startPage, currentLeftCanvas, currentRightCanvas);
                            currentStartPage = startPage;
                        } else {
                            await renderSpreadToCanvases(startPage, nextLeftCanvas, nextRightCanvas);
                            await animateTurn(direction);
                            copySpreadToCurrent();
                            currentStartPage = startPage;
                        }
                    } catch (err) {
                        console.error(err);
                        showFallback('Không đọc được file PDF.');
                    } finally {
                        isRendering = false;
                        updateControls();

                        if (pendingSpread) {
                            const next = pendingSpread;
                            pendingSpread = null;
                            renderSpread(next.startPage, next.direction);
                        }
                    }
                }

                function goToSpread(startPage, direction) {
                    if (!pdfDoc) return;
                    const safeStart = Math.max(1, Math.min(startPage, pdfDoc.numPages));
                    if (safeStart === currentStartPage) return;
                    renderSpread(safeStart, direction);
                }

                if (!window.pdfjsLib) {
                    showFallback('Không tải được thư viện PDF.js.');
                    return;
                }

                pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

                pdfjsLib.getDocument(pdfUrl).promise.then(async function (pdf) {
                    pdfDoc = pdf;
                    if (status) status.style.display = 'none';
                    if (reader) reader.style.display = 'flex';

                    await renderSpread(1, null);

                    prevBtn.addEventListener('click', function () {
                        goToSpread(currentStartPage - 2, 'prev');
                    });

                    nextBtn.addEventListener('click', function () {
                        goToSpread(currentStartPage + 2, 'next');
                    });

                    if (fullscreenBtn) {
                        fullscreenBtn.addEventListener('click', toggleFullscreen);
                    }

                    document.addEventListener('fullscreenchange', function () {
                        updateFullscreenButton();
                        setTimeout(function () {
                            renderSpread(currentStartPage, null);
                        }, 180);
                    });

                    document.addEventListener('webkitfullscreenchange', function () {
                        updateFullscreenButton();
                        setTimeout(function () {
                            renderSpread(currentStartPage, null);
                        }, 180);
                    });

                    const hotspotPrev = document.getElementById('hotspotPrev');
                    const hotspotNext = document.getElementById('hotspotNext');

                    if (hotspotPrev) {
                        hotspotPrev.addEventListener('click', function () {
                            goToSpread(currentStartPage - 2, 'prev');
                        });
                    }

                    if (hotspotNext) {
                        hotspotNext.addEventListener('click', function () {
                            goToSpread(currentStartPage + 2, 'next');
                        });
                    }

                    let touchStartX = 0;
                    let touchStartY = 0;

                    document.addEventListener('touchstart', function (event) {
                        if (!event.changedTouches || !event.changedTouches.length) return;
                        touchStartX = event.changedTouches[0].clientX;
                        touchStartY = event.changedTouches[0].clientY;
                    }, { passive: true });

                    document.addEventListener('touchend', function (event) {
                        if (!event.changedTouches || !event.changedTouches.length) return;
                        const deltaX = event.changedTouches[0].clientX - touchStartX;
                        const deltaY = event.changedTouches[0].clientY - touchStartY;

                        if (Math.abs(deltaX) < 80 || Math.abs(deltaX) < Math.abs(deltaY) * 1.35) return;

                        if (deltaX > 0) {
                            goToSpread(currentStartPage - 2, 'prev');
                        } else {
                            goToSpread(currentStartPage + 2, 'next');
                        }
                    }, { passive: true });

                    document.addEventListener('keydown', function (event) {
                        if (event.key === 'ArrowLeft') goToSpread(currentStartPage - 2, 'prev');
                        if (event.key === 'ArrowRight') goToSpread(currentStartPage + 2, 'next');

                        if (event.key === 'f' || event.key === 'F' || event.key === 'F11') {
                            event.preventDefault();
                            toggleFullscreen();
                        }
                    });

                    window.addEventListener('resize', function () {
                        clearTimeout(window.__pdfResizeTimer);
                        window.__pdfResizeTimer = setTimeout(function () {
                            renderSpread(currentStartPage, null);
                        }, 250);
                    });
                }).catch(function (err) {
                    console.error(err);
                    showFallback('Không đọc được file PDF.');
                });
            });
        </script>
    }
}
