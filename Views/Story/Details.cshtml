@section Scripts {
    <script>
        let fontSize = Number(localStorage.getItem('storyFontSize')) || 1.05;
        let darkMode = localStorage.getItem('storyDarkMode') === 'true';

        function applyReadingSettings() {
            const readingArea = document.getElementById('readingArea');
            const contentCard = document.getElementById('story-content');
            const btn = document.getElementById('darkModeBtn');

            if (readingArea) {
                readingArea.style.fontSize = fontSize + 'rem';
            }

            if (contentCard) {
                contentCard.classList.toggle('reading-dark', darkMode);
            }

            if (btn) {
                btn.innerHTML = darkMode ? '<i class="fas fa-sun"></i>' : '<i class="fas fa-moon"></i>';
                btn.title = darkMode ? 'Chế độ sáng' : 'Chế độ tối';
            }
        }

        function changeFontSize(delta) {
            fontSize = Math.min(1.6, Math.max(0.8, fontSize + delta * 0.08));
            localStorage.setItem('storyFontSize', fontSize.toString());
            applyReadingSettings();
        }

        function toggleDarkMode() {
            darkMode = !darkMode;
            localStorage.setItem('storyDarkMode', darkMode.toString());
            applyReadingSettings();
        }

        document.addEventListener('DOMContentLoaded', applyReadingSettings);

        function showToast(msg, success = true) {
            const t = document.getElementById('toast');
            t.innerHTML = `<i class="fas ${success ? 'fa-check-circle text-success' : 'fa-exclamation-circle text-danger'} me-2"></i>${msg}`;
            t.style.borderLeftColor = success ? 'var(--success)' : 'var(--danger)';
            t.style.display = 'block';
            setTimeout(() => { t.style.display = 'none'; }, 3000);
        }

        function toggleFavorite(storyId) {
            fetch('/Story/ToggleFavoriteAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ storyId })
            }).then(r => r.json()).then(data => {
                const btn = document.getElementById('favoriteBtn');
                const txt = document.getElementById('favText');
                if (data.isFavorite) {
                    btn.classList.add('active');
                    txt.textContent = 'Đã lưu';
                    showToast('Đã thêm vào yêu thích!');
                } else {
                    btn.classList.remove('active');
                    txt.textContent = 'Lưu truyện';
                    showToast('Đã xóa khỏi yêu thích!');
                }
            }).catch(() => showToast('Có lỗi xảy ra!', false));
        }

        function toggleLike(storyId) {
            fetch('/Story/LikeAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ storyId })
            }).then(r => r.json()).then(data => {
                document.getElementById('likeCount').textContent = data.likes;
                showToast('Đã thích truyện!');
            }).catch(() => showToast('Có lỗi xảy ra!', false));
        }

        function showReplyForm(commentId) {
            const form = document.getElementById('replyForm-' + commentId);
            form.style.display = form.style.display === 'none' ? 'block' : 'none';
        }

        function submitComment(storyId, parentId) {
            const textareaId = parentId ? 'replyText-' + parentId : 'commentText';
            const content = document.getElementById(textareaId).value.trim();
            if (!content) { showToast('Vui lòng nhập nội dung bình luận!', false); return; }

            fetch('/Story/AddComment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ storyId, content, parentCommentId: parentId })
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    document.getElementById(textareaId).value = '';
                    if (parentId) document.getElementById('replyForm-' + parentId).style.display = 'none';
                    showToast('Bình luận đã được đăng!');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message || 'Có lỗi xảy ra!', false);
                }
            }).catch(() => showToast('Có lỗi xảy ra!', false));
        }

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }
    </script>
    @Html.AntiForgeryToken()
}
